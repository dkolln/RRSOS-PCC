{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },

  "AllowedHosts": "*",

  "SaveSettings": {
    // Folders are auto-detected when left out. Uncomment to override:
    //   "SavePath": the game's save folder (default: %USERPROFILE%\AppData\LocalLow\MijuGames\Planet Crafter)
    //   "AssetPath": shipped reference data (default: <content root>\Assets)
    //   "UserDataPath": notebook, base names, settings (default: %LOCALAPPDATA%\RRSOS-PCC)

    // Save polling. The app learns the game's real save cadence, so these are only starting points.
    "AutoRefreshIntervalSeconds": 10,
    "ExpectedSaveIntervalSeconds": 60,
    "EarlyPollLeadSeconds": 10,
    "FinePollIntervalMs": 1000,
    "OverdueGraceSeconds": 20
  }
}
