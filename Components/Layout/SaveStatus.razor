@using RRSOS_PCC.Classes
@using RRSOS_PCC.Services
@implements IDisposable
@inject SaveService SaveSvc

<div class="save-status">
    @if (SaveSvc.LastLoadError is { } error)
    {
        <span class="save-status-error">@error</span>
    }
    else
    {
        <span>@StatusLine</span>
    }
</div>

@code {
    private System.Threading.Timer? _timer;

    protected override void OnInitialized()
    {
        // This component ticks on its own so only this one line redraws each second,
        // not the whole page.
        _timer = new System.Threading.Timer(_ => Tick(), null, TimeSpan.FromSeconds(1), TimeSpan.FromSeconds(1));
    }

    private void Tick()
    {
        try { _ = InvokeAsync(StateHasChanged); }
        catch (ObjectDisposedException) { /* circuit already gone */ }
    }

    private string StatusLine
    {
        get
        {
            var loaded = SaveSvc.LastLoadedAtUtc;
            if (loaded is null)
                return "NO SAVE LOADED";

            var text = $"LOADED {loaded.Value.ToLocalTime():HH:mm:ss}";

            if (SaveSvc.Schedule.ExpectedUtc is not DateTime expected)
                return text;

            var remaining = expected - DateTime.UtcNow;

            if (remaining > TimeSpan.Zero)
                return $"{text} // NEXT SAVE ~{Format(remaining)}";

            if (SaveSvc.Schedule.Phase != PollPhase.Overdue)
                return $"{text} // WAITING FOR SAVE...";

            // A save that is many minutes late means the game is closed or paused, not a slow autosave.
            return -remaining > TimeSpan.FromMinutes(10)
                ? $"{text} // SAVE IS {Format(-remaining)} OLD"
                : $"{text} // SAVE OVERDUE {Format(-remaining)}";
        }
    }

    private static string Format(TimeSpan span) =>
        span.TotalHours >= 1
            ? $"{(int)span.TotalHours}:{span.Minutes:00}:{span.Seconds:00}"
            : $"{(int)span.TotalMinutes}:{span.Seconds:00}";

    public void Dispose()
    {
        _timer?.Dispose();
    }
}
