@using RRSOS_PCC.Services
@using RRSOS_PCC.Classes
@inherits LayoutComponentBase
@implements IDisposable
@inject NavigationManager NavigationManager
@inject SaveService SaveSvc
@inject PCLauncherService Launcher
@inject IJSRuntime JS

<div class="rrs-shell">

    <nav class="rrs-tabs">
        <div class="rrs-status" @onclick="@(() => TabSelected("/"))">Home</div>
        <div class="rrs-status" @onclick="@(() => TabSelected("/rawJson"))">Raw JSON</div>
        <div class="rrs-status" @onclick="@(() => TabSelected("/missinggId"))">Missing gIds</div>
    </nav>

    <div class="rrs-header-row">

        <div class="rrs-col">
            <label>FILE LOCATION</label>
            <div class="rrs-status clickable" @onclick="OpenSaveFolder">
                ⬒ OPEN SAVE FILE LOCATION
            </div>
        </div>

        <div class="rrs-col">
            <label>GAME LAUNCHER</label>
            <button class="rrs-status" @onclick="HandleLaunchClick">
                @ButtonText
            </button>
        </div>

        <div class="rrs-col">
            <label>SAVE SLOT</label>
            <select @onchange="OnSaveSelected" class="save-dropdown">
                @foreach (var file in _saveFiles)
                {
                    <option value="@file" selected="@(file == SaveSvc.SelectedSaveFile)">
                        @file
                    </option>
                }
            </select>
        </div>

    </div>

    <main class="rrs-panel">
        @Body
    </main>

    <footer class="rrs-footer">
        <SaveStatus />
        PROPERTY OF RRS // AUTHORIZED PERSONNEL ONLY
    </footer>

</div>

@code {

    private Func<Task>? _changeHandler;
    private System.Threading.Timer? _launcherTimer;

    private IReadOnlyList<string> _saveFiles = Array.Empty<string>();
    private bool _gameRunning;

    private string ButtonText => _gameRunning ? "RELAUNCH PC" : "LAUNCH PC";

    protected override async Task OnInitializedAsync()
    {
        _saveFiles = PathResolver.ListSaveFiles();
        _gameRunning = Launcher.IsRunning();

        // The layout only redraws when a new save arrives (or its load status changes).
        _changeHandler = () =>
        {
            _saveFiles = PathResolver.ListSaveFiles();
            return InvokeAsync(StateHasChanged);
        };
        SaveSvc.OnChange += _changeHandler;

        // Is the game running? Ask a few times a minute and only redraw if the answer changed,
        // instead of scanning every process on every render.
        _launcherTimer = new System.Threading.Timer(
            _ => CheckGameRunning(), null, TimeSpan.FromSeconds(5), TimeSpan.FromSeconds(5));

        // Starts the background watcher (idempotent) and loads the current save if needed.
        await SaveSvc.StartAutoRefresh();
    }

    private void CheckGameRunning()
    {
        var running = Launcher.IsRunning();
        if (running == _gameRunning)
            return;

        _gameRunning = running;

        try { _ = InvokeAsync(StateHasChanged); }
        catch (ObjectDisposedException) { /* circuit already gone */ }
    }

    public void Dispose()
    {
        if (_changeHandler != null)
            SaveSvc.OnChange -= _changeHandler;

        _launcherTimer?.Dispose();
    }

    void TabSelected(string route)
    {
        NavigationManager.NavigateTo(route);
    }

    public void OpenSaveFolder()
    {
        SaveSvc.OpenSaveFolder();
    }

    private async Task HandleLaunchClick()
    {
        if (Launcher.CheckNow())
        {
            var confirmed = await JS.InvokeAsync<bool>(
                "confirm",
                "Planet Crafter is running. Relaunching closes it immediately and any unsaved progress is lost. Continue?");

            if (!confirmed)
                return;

            await Launcher.ForceRelaunch();
        }
        else
        {
            Launcher.Launch();
        }

        _gameRunning = Launcher.CheckNow();
    }

    private async Task OnSaveSelected(ChangeEventArgs e)
    {
        var file = e.Value?.ToString();

        if (string.IsNullOrWhiteSpace(file))
            return;

        SaveSvc.SelectedSaveFile = file;
        await SaveSvc.Load();
    }
}
