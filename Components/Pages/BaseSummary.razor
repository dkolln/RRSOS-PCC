@using RRSOS_PCC.ViewModels

<div class="pcc-readout">

    @foreach (var b in DisplayList)
    {
        <div class="readout-section base-row @(b.Id == SelectedId ? "selected" : "")"
             title="@(b.Id == PinnedId ? "Pinned. Click to follow the nearest base again." : "Click to show this base.")"
             @onclick="() => OnSelect.InvokeAsync(b.Id)">

            <div class="readout-line">
                <span class="base-title">@b.Name @b.DisplayDistance @b.DisplayPosition @b.Direction</span>

                @if (b.Id == PinnedId)
                {
                    <span class="lock-indicator">🔒</span>
                }
            </div>
        </div>
    }
</div>
