@using RRSOS_PCC.Enums
@using RRSOS_PCC.Classes
@using RRSOS_PCC.Models
@using RRSOS_PCC.Services
@inject SaveService SaveSvc
@inject BaseNamingService BaseNamingSvc

<div class="pcc-readout">
    <div class="readout-header">BASE CONTENTS</div>

    <div class="group-controls">
        <span>Group by:</span>

        <button class="group-btn" @onclick="() => SetGroup(GroupMode.Name)">Name</button>
        <button class="group-btn" @onclick="() => SetGroup(GroupMode.Type)">Type</button>
        <button class="group-btn" @onclick="() => SetGroup(GroupMode.Category)">Category</button>
    </div>


    @if (SelectedBase is null)
    {
        <div class="row warning">Select a base from the summary.</div>
    }
    else if (Processed is null)
    {
        <div class="row warning">No containers found.</div>
    }
    else
    {
        <div class="manifest-group resource">
            <div class="category-header">-- Resource --</div>
        <div class="readout-section">
            @foreach (var cat in Processed.CategorizedItems)
            {
                <div class="two-col">
                    <div class="col-left">
                        @foreach (var item in cat.Left)
                        {
                            <div class="row">
                                <span>@item.Name @item.Count</span>
                            </div>
                        }
                    </div>

                    <div class="col-right">
                        @foreach (var item in cat.Right)
                        {
                            <div class="row">
                                <span>@item.Name @item.Count</span>
                            </div>
                        }
                    </div>
                </div>
            }
            </div>
            </div>

        @if (GrowerItemsView.Any())
        {
            <div class="manifest-group boneyard">
                <div class="category-header">-- Grower Items --</div>
                <div class="readout-section">
                    <div class="two-col">
                        <div class="col-left">
                            @foreach (var b in GrowerItemsView)
                            {
                                <div class="row">
                                    <span>@b.Name @b.Count</span>
                                </div>
                            }
                        </div>
                    </div>
                </div>
            </div>
        }

            @if (Processed.Boneyard.Any())
            {
                <div class="manifest-group boneyard">
                    <div class="category-header">-- Boneyard (Loose) --</div>
                    <div class="readout-section">
                    <div class="two-col">
                        <div class="col-left">
                            @foreach (var b in Processed.BoneyardLeft)
                            {
                                <div class="row">
                                    <span>@b.Name @b.Count</span>
                                </div>
                            }
                        </div>

                        <div class="col-right">
                            @foreach (var b in Processed.BoneyardRight)
                            {
                                <div class="row">
                                    <span>@b.Name @b.Count</span>
                                </div>
                            }
                        </div>
                    </div>
                    </div>
                </div>
            }
        

        <div class="readout-section">
            <input class="search-box"
                   placeholder="Search items..."
                   @bind="SearchText"
                   @bind:event="oninput" />

            @if (!string.IsNullOrWhiteSpace(SearchText))
            {
                <div class="search-results">
                    @foreach (var item in GroupedResults)
                    {
                        <div class="item-header">
                            <b>@item.ItemName</b>
                        </div>

                        @foreach (var loc in item.Locations)
                        {
                            <div class="search-row">
                                - @loc.LocationName —
                                @loc.Count items —
                                nearest @loc.NearestDistance m @loc.Direction
                                @if (loc.BasePos != "—")
                                {
                                    <span>(@loc.BasePos)</span>
                                }
                            </div>
                        }

                        <br />
                    }

                </div>
            }
        </div>

    }
</div>
