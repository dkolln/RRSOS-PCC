@using RRSOS_PCC.Enums
@using RRSOS_PCC.Classes
@using RRSOS_PCC.Models
@using RRSOS_PCC.Services
@inject SaveService SaveSvc
@inject BaseNamingService BaseNamingSvc

<div class="pcc-readout">

    @if (SelectedBase is null)
    {
        <div class="row warning">No bases found.</div>
    }
    else if (Processed is null)
    {
        <div class="row warning">No contents found.</div>
    }
    else
    {
        <div class="base-title-row">
            <span class="base-name">@SelectedBase.Name</span>
            <span class="base-meta">@SelectedBase.DisplayDistance @SelectedBase.Direction</span>

            @if (IsPinned)
            {
                <button class="follow-btn" @onclick="OnFollowNearest" title="Go back to showing the nearest base">🔒 Follow nearest</button>
            }
            else
            {
                <span class="base-meta">nearest</span>
            }
        </div>

        <div class="group-controls">
            <span>Group by:</span>

            @foreach (var (mode, label) in Modes)
            {
                <button class="group-btn @(CurrentGroup == mode ? "active" : "")" @onclick="() => SetGroup(mode)">@label</button>
            }
        </div>

        @if (!Processed.Stored.Any && !Processed.ReadyToHarvest.Any && !Processed.Boneyard.Any)
        {
            <div class="base-empty">Nothing stored here.</div>
        }

        @ItemGroup(GroupTitle, "resource", Processed.Stored)
        @ItemGroup("Ready to harvest", "boneyard", Processed.ReadyToHarvest)
        @ItemGroup("Boneyard (loose)", "boneyard", Processed.Boneyard)

        <div class="readout-section">
            <input class="search-box"
                   placeholder="Search items..."
                   @bind="SearchText"
                   @bind:event="oninput" />

            @if (!string.IsNullOrWhiteSpace(SearchText))
            {
                <div class="search-results">
                    @foreach (var item in GroupedResults)
                    {
                        <div class="item-header">
                            <b>@item.ItemName</b>
                        </div>

                        @foreach (var loc in item.Locations)
                        {
                            <div class="search-row">
                                - @loc.LocationName —
                                @loc.Count items —
                                nearest @loc.NearestDistance m @loc.Direction
                                @if (loc.BasePos != "—")
                                {
                                    <span>(@loc.BasePos)</span>
                                }
                            </div>
                        }

                        <br />
                    }
                </div>
            }
        </div>
    }
</div>

@code {
    private static readonly (GroupMode Mode, string Label)[] Modes =
    {
        (GroupMode.Name, "Name"),
        (GroupMode.Type, "Type"),
        (GroupMode.Category, "Category")
    };

    // One boxed list of counted items in two columns. Nothing is drawn when the list is empty.
    private RenderFragment ItemGroup(string title, string kind, ItemList items) => @<text>
        @if (items.Any)
        {
            <div class="manifest-group @kind">
                <div class="category-header">@title</div>
                <div class="two-col">
                    <div class="col-left">
                        @foreach (var item in items.Left)
                        {
                            <div class="row"><span>@item.Name</span><span class="count">@item.Count</span></div>
                        }
                    </div>

                    <div class="col-right">
                        @foreach (var item in items.Right)
                        {
                            <div class="row"><span>@item.Name</span><span class="count">@item.Count</span></div>
                        }
                    </div>
                </div>
            </div>
        }
    </text>;
}
