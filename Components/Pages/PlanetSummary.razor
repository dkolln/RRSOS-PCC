@using RRSOS_PCC.Classes
@using RRSOS_PCC.ViewModels

<div class="pcc-readout">

    <div class="readout-header">PLANET SUMMARY (@Data?.PlanetId)</div>

    @if (Data is null)
    {
        <div class="readout-line">No planet data loaded.</div>
    }
    else
    {
        @* One dial per category: the needle is how far it is from an equal share. Details are hover-only. *@
        <div class="readout-section">
            <div class="ti-gauges">
                @foreach (var category in Data.Categories)
                {
                    <div class="ti-gauge @(category.Status == TiStatus.Idle ? "is-idle" : "")" title="@Tooltip(category)">
                        <Gauge Label="@category.Name"
                               Centered="true"
                               Value="@(category.Deviation / TiBalance.ScalePoints)"
                               Unknown="@(category.Status == TiStatus.Idle)"
                               StatusOverride="@StatusName(category.Status)"
                               DisplayText="@Signed(category.Deviation)"
                               MinLabel="@Scale("−")"
                               MaxLabel="@Scale("+")" />
                        <div class="ti-value">@PCMath.MultiplierAbbreviation(category.Value)</div>
                    </div>
                }
            </div>
        </div>

        <div class="readout-section">
            <div class="readout-line">
                <span class="label">» Total TI</span>
                <span class="value">@Data.TotalTI.ToString("N0")</span>
            </div>
        </div>
    }

    <PowerSummary Data="@Power" />
</div>
