@using Microsoft.JSInterop
@using RRSOS_PCC.ViewModels

<div class="readout-section">
    <div class="readout-header">Power</div>

    @if (Data is null || !Data.HasAnyMachines)
    {
        <div class="readout-line">No power machines placed.</div>
    }
    else
    {
        <div class="power-body">
          @* Wind and solar sit left of the dial, nuclear and fusion right, so the bottom of the card stays clear. *@
          <div class="power-main">
            <div class="power-side power-side-left">@GroupList(LeftGroups)</div>
            <div class="power-center">
            <button type="button" class="power-dial" @ref="_dialButton" @onclick="Open"
                    aria-haspopup="dialog" aria-label="@DialLabel" title="Show power breakdown">
                <Gauge Label="Power load"
                       Value="@Data.Load"
                       Unknown="@(!Data.HasUsageData)"
                       DisplayText="@LoadText"
                       MaxLabel="@Compact(Data.Capacity)"
                       HigherIsWorse="true"
                       WarnAt="@PowerSummaryViewModel.LoadWarnAt"
                       CritAt="@PowerSummaryViewModel.LoadCritAt" />
            </button>

            @* One figure: what is left while there is any, what is missing once there is not. *@
            <div class="power-values">
                <div class="power-value @ValueClass">
                    <span class="num">@(Data.HasUsageData ? Kw(Math.Abs(Data.Spare)) : "--")</span>
                    <span class="lbl">@(Short ? "Short" : "Left")</span>
                </div>
            </div>

            </div>
            <div class="power-side power-side-right">@GroupList(RightGroups)</div>
          </div>

            @if (Data.Unrated.Count > 0)
            {
                <div class="power-note">
                    @Data.Unrated.Count generator type(s) have no rate yet, so capacity is understated.
                </div>
            }
        </div>
    }
</div>

@if (_open && Data is not null)
{
    <div class="power-backdrop" @ref="_overlay" tabindex="-1" @onclick="Close" @onkeydown="OnKeyDown">
        <div class="power-dialog" role="dialog" aria-modal="true" aria-labelledby="power-dialog-title" @onclick:stopPropagation>
            <div class="power-dialog-header">
                <span id="power-dialog-title">Power breakdown</span>
                <button type="button" class="power-close" @onclick="Close" aria-label="Close">✖</button>
            </div>

            <div class="power-dialog-summary">
                <div><span class="lbl">Capacity</span><span class="num power-left">@Kw(Data.Capacity)</span></div>
                <div><span class="lbl">Needed</span><span class="num power-need">@(Data.HasUsageData ? Kw(Data.Required) : "unknown")</span></div>
                @if (Data.HasUsageData)
                {
                    <div>
                        <span class="lbl">@(Short ? "Short" : "Left")</span>
                        <span class="num @(Short ? "power-need" : "power-left")">@Kw(Math.Abs(Data.Spare))</span>
                    </div>
                    <div><span class="lbl">Load</span><span class="num">@LoadText</span></div>
                }
            </div>

            <div class="power-dialog-columns">
                <PowerLineTable Kind="input" Title="Input (generation)" Lines="@Data.Generation"
                                Unrated="@Data.Unrated" Total="@Data.Capacity"
                                EmptyText="No generators placed." />

                <PowerLineTable Kind="output" Title="Output (usage)" Lines="@Data.Consumption"
                                Total="@Data.Required"
                                EmptyText="No usage rates defined yet." />
            </div>
        </div>
    </div>
}

@code {
    private ElementReference _dialButton;
    private ElementReference _overlay;
    private bool _open;
    private bool _focusOverlay;
    private bool _focusDial;

    [Parameter]
    public PowerSummaryViewModel? Data { get; set; }

    // A base with dozens of one kind would otherwise push everything else off the card.
    private const int MaxIconsPerGroup = 40;

    // Wind and solar go left of the dial; everything else (nuclear, fusion, unknown) goes right.
    private static readonly HashSet<string> LeftIcons = new(StringComparer.OrdinalIgnoreCase) { "windmill", "sun", "sun-large" };

    private IEnumerable<GeneratorGroup> LeftGroups => Groups.Where(g => g.Icon is not null && LeftIcons.Contains(g.Icon));

    private IEnumerable<GeneratorGroup> RightGroups => Groups.Where(g => g.Icon is null || !LeftIcons.Contains(g.Icon));

    // One little picture per generator on the grid.
    private RenderFragment GroupList(IEnumerable<GeneratorGroup> groups) => @<text>
        @foreach (var group in groups)
        {
            <div class="power-gen-group" title="@group.Title" role="img" aria-label="@group.Label">
                @for (var i = 0; i < Math.Min(group.Count, MaxIconsPerGroup); i++)
                {
                    <PowerIcon Kind="@group.Icon" Index="@i" Dim="@group.Dim" />
                }
                @if (group.Count > MaxIconsPerGroup)
                {
                    <span class="power-gen-more">+@(group.Count - MaxIconsPerGroup)</span>
                }
            </div>
        }
    </text>;

    private sealed record GeneratorGroup(string? Icon, int Count, bool Dim, string Title, string Label);

    /// <summary>Generators of one type together, however many different boosts they run at, then the ones with no known output.</summary>
    private IReadOnlyList<GeneratorGroup> Groups
    {
        get
        {
            if (Data is null)
                return Array.Empty<GeneratorGroup>();

            var groups = new List<GeneratorGroup>();

            foreach (var type in Data.Generation.GroupBy(l => l.GId))
            {
                var count = type.Sum(l => l.Count);
                var title = string.Join("\n", type.Select(l => $"{l.Name} ×{l.Count}: {Kw(l.KwTotal)}"));
                groups.Add(new GeneratorGroup(type.First().Icon, count, false, title, $"{count} {BaseName(type.First().Name)}"));
            }

            foreach (var line in Data.Unrated)
                groups.Add(new GeneratorGroup(line.Icon, line.Count, true, $"{line.Name} ×{line.Count}: no rate yet", $"{line.Count} {line.Name}, output unknown"));

            return groups;
        }
    }

    // "Fusion Generator T6 (6×)" -> "Fusion Generator T6"
    private static string BaseName(string name)
    {
        var at = name.LastIndexOf(" (", StringComparison.Ordinal);
        return at > 0 && name.EndsWith("×)") ? name[..at] : name;
    }

    private bool Short => Data is { HasUsageData: true, Spare: < 0 };

    // Matches the dial: green while comfortable, then yellow and red as load climbs. A shortfall is always red.
    private string ValueClass => Data is null || !Data.HasUsageData ? "power-idle"
        : Short || Data.Load >= PowerSummaryViewModel.LoadCritAt ? "power-need"
        : Data.Load >= PowerSummaryViewModel.LoadWarnAt ? "power-warn"
        : "power-left";

    private string LoadText => Data is { HasUsageData: true } ? $"{(int)Math.Round(Data.Load * 100)}%" : "--";

    private string DialLabel => Data is { HasUsageData: true }
        ? $"Power load {LoadText}: {Kw(Data.Required)} needed of {Kw(Data.Capacity)} available. Open breakdown."
        : $"Power capacity {Kw(Data?.Capacity ?? 0)}, usage unknown. Open breakdown.";

    private void Open()
    {
        _open = true;
        _focusOverlay = true;
    }

    private void Close()
    {
        _open = false;
        _focusDial = true;
    }

    private void OnKeyDown(KeyboardEventArgs e)
    {
        if (e.Key == "Escape")
            Close();
    }

    // Move focus into the dialog when it opens and back to the dial when it closes.
    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        try
        {
            if (_focusOverlay)
            {
                _focusOverlay = false;
                await _overlay.FocusAsync();
            }
            else if (_focusDial)
            {
                _focusDial = false;
                await _dialButton.FocusAsync();
            }
        }
        catch (Exception ex) when (ex is JSException or JSDisconnectedException or InvalidOperationException)
        {
            // Circuit gone or element replaced by a re-render; losing focus is harmless.
        }
    }

    private static string Kw(decimal value) => $"{value:#,##0.0#} kW";

    // Short form for the small scale label on the dial, e.g. 64,597.5 -> "64.6K".
    private static string Compact(decimal value) =>
        value >= 1000 ? $"{value / 1000:0.#}K" : $"{value:0.#}";
}
