@using RRSOS_PCC.ViewModels

<div class="pcc-readout">

    <div class="readout-header">PLAYER SUMMARY</div>
    <div>@DateTime.Now</div>

    @if (Data is null)
    {
        <div class="readout-line">No player data loaded.</div>
    }
    else
    {
        <!-- Position -->
        <div class="readout-section">
            <div class="readout-header">Position</div>

            <NavDisplay Position="@Data.Position.Full" Heading="@Data.Rotation.Degrees"
                        Bases="@Bases" SelectedBaseId="@SelectedBaseId" OnBaseSelect="OnBaseSelect" />
        </div>

        <!-- Vitals -->
        <div class="readout-section">
            <div class="readout-header">Vitals</div>

            <div class="gauge-row">
                @* Oxygen is the one vital with a real amount, so its scale ends at the tank size instead of 100. *@
                <Gauge Label="Oxygen" Value="@Data.Vitals.OxygenPct"
                       MaxLabel="@(Data.Vitals.OxygenCapacity > 0 ? Data.Vitals.OxygenCapacity.ToString("0.#") : "100")"
                       WarnAt="@VitalsViewModel.LowWarnBelow" CritAt="@VitalsViewModel.LowCritBelow" />
                <Gauge Label="Health" Value="@Data.Vitals.HealthPct"
                       WarnAt="@VitalsViewModel.LowWarnBelow" CritAt="@VitalsViewModel.LowCritBelow" />
                <Gauge Label="Thirst" Value="@Data.Vitals.ThirstPct"
                       WarnAt="@VitalsViewModel.LowWarnBelow" CritAt="@VitalsViewModel.LowCritBelow" />
                <Gauge Label="Toxicity" Value="@Data.Vitals.ToxicPct"
                       HigherIsWorse="true" WarnAt="@VitalsViewModel.HighWarnAbove" CritAt="@VitalsViewModel.HighCritAbove" />
            </div>
        </div>

        <!-- Backpack -->
        <div class="readout-section">
            <details class="readout-fold">
                <summary>Backpack (@Data.Backpack.Count)</summary>

                <div class="readout-grid-2">
                    <div>
                        @foreach (var item in LeftColumn)
                        {
                            <div class="readout-line">
                                <span class="label">» @item.Name</span>
                                <span class="value">@item.Count</span>
                            </div>
                        }
                    </div>

                    <div>
                        @foreach (var item in RightColumn)
                        {
                            <div class="readout-line">
                                <span class="label">» @item.Name</span>
                                <span class="value">@item.Count</span>
                            </div>
                        }
                    </div>
                </div>
            </details>
        </div>

        <!-- Equipment -->
        <div class="readout-section">
            <details class="readout-fold">
                <summary>Equipment (@Data.Equipment.Count)</summary>

                <div class="readout-grid-2">
                    <div>
                        @foreach (var item in EquipmentLeftColumn)
                        {
                            <div class="readout-line">
                                <span class="label">» @item.Name</span>
                            </div>
                        }
                    </div>

                    <div>
                        @foreach (var item in EquipmentRightColumn)
                        {
                            <div class="readout-line">
                                <span class="label">» @item.Name</span>
                            </div>
                        }
                    </div>
                </div>
            </details>
        </div>
    }

</div>
