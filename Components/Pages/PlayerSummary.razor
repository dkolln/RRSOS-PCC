<div class="pcc-readout">

    <div class="readout-header">PLAYER SUMMARY</div>
    <div>@DateTime.Now</div>

    @if (Data is null)
    {
        <div class="readout-line">No player data loaded.</div>
    }
    else
    {
        <!-- Position -->
        <div class="readout-section">
            <div class="readout-header">Position</div>

            <div class="readout-line">
                <span class="label">» Position</span>
                <span class="value">@Data.Position.Display2D</span>
            </div>

            <div class="readout-line">
                <span class="label">» Elevation</span>
                <span class="value">@Data.Position.DisplayElevation</span>
            </div>

            <div class="readout-line">
                <span class="label">» Heading</span>
                <span class="value">@Data.Rotation.Heading</span>
            </div>
        </div>

        <!-- Vitals -->
        <div class="readout-section">
            <div class="readout-header">Vitals</div>

            <div class="readout-line">
                <span class="label">» Health</span>
                <span class="value @(Data.Vitals.HealthCritical ? "crit" : Data.Vitals.HealthWarning ? "warn" : "")">
                    @(Data.Vitals.HealthPct.ToString("P0"))
                </span>
            </div>

            <div class="readout-line">
                <span class="label">» Oxygen</span>
                <span class="value @(Data.Vitals.OxygenCritical ? "crit" : Data.Vitals.OxygenWarning ? "warn" : "")">
                    @(Data.Vitals.OxygenPct.ToString("P0"))
                </span>
            </div>

            <div class="readout-line">
                <span class="label">» Thirst</span>
                <span class="value @(Data.Vitals.ThirstCritical ? "crit" : Data.Vitals.ThirstWarning ? "warn" : "")">
                    @(Data.Vitals.ThirstPct.ToString("P0"))
                </span>
            </div>

            <div class="readout-line">
                <span class="label">» Toxicity</span>
                <span class="value @(Data.Vitals.ToxicCritical ? "crit" : Data.Vitals.ToxicWarning ? "warn" : "")">
                    @(Data.Vitals.ToxicPct.ToString("P0"))
                </span>
            </div>
        </div>

        <!-- Backpack -->
        <div class="readout-section">
            <div class="readout-header">Backpack (@Data.Backpack.Count)</div>

            <div class="readout-grid-2">
                <div>
                    @foreach (var item in LeftColumn)
                    {
                        <div class="readout-line">
                            <span class="label">» @item.Name</span>
                            <span class="value">@item.Count</span>
                        </div>
                    }
                </div>

                <div>
                    @foreach (var item in RightColumn)
                    {
                        <div class="readout-line">
                            <span class="label">» @item.Name</span>
                            <span class="value">@item.Count</span>
                        </div>
                    }
                </div>
            </div>
        </div>

        <!-- Equipment -->
        <div class="readout-section">
            <div class="readout-header">Equipment (@Data.Equipment.Count)</div>

            <div class="readout-grid-2">
                <div>
                    @foreach (var item in EquipmentLeftColumn)
                    {
                        <div class="readout-line">
                            <span class="label">» @item.Name</span>
                        </div>
                    }
                </div>

                <div>
                    @foreach (var item in EquipmentRightColumn)
                    {
                        <div class="readout-line">
                            <span class="label">» @item.Name</span>
                        </div>
                    }
                </div>
            </div>
        </div>
    }

</div>
