@page "/"
@using RRSOS_PCC.Services
@using RRSOS_PCC.Components.Pages

@layout MainLayout
@inject NavigationManager NavigationManager

<nav class="home-tabs" role="tablist">
    <button class="home-tab @(Tab == HomeTab.Main ? "active" : "")" role="tab" aria-selected="@(Tab == HomeTab.Main)"
            @onclick="() => Tab = HomeTab.Main">
        Main
    </button>
    <button class="home-tab @(Tab == HomeTab.Base ? "active" : "")" role="tab" aria-selected="@(Tab == HomeTab.Base)"
            @onclick="() => Tab = HomeTab.Base">
        Base
    </button>
    <button class="home-tab @(Tab == HomeTab.Extractors ? "active" : "")" role="tab" aria-selected="@(Tab == HomeTab.Extractors)"
            @onclick="() => Tab = HomeTab.Extractors">
        Extractors (@ExtractorVMs.Count)
    </button>
</nav>

@* Every tab stays in the page and the inactive ones are only hidden, so nothing resets when you switch
   (the player's map trail keeps recording, the selected base and open lists are kept). *@

<div class="home-grid @PaneClass(HomeTab.Main)">

    <div class="readout-section">
        <div class="readout-header" @onclick="() => ShowPlayer = !ShowPlayer">
            PLAYER <span>@(ShowPlayer ? "▼" : "▶")</span>
        </div>
        @if (ShowPlayer)
        {
            <ResupplyButton />
            <PlayerSummary Data="@PlayerVM" />
        }
    </div>

    <div class="readout-section">
        <div class="readout-header" @onclick="() => ShowPlanet = !ShowPlanet">
            PLANET <span>@(ShowPlanet ? "▼" : "▶")</span>
        </div>
        @if (ShowPlanet)
        {
            <PlanetSummary Data="@PlanetVM" Power="@PowerVM" />
        }
    </div>

    @* The vehicle card is short now that its lists fold, so the notes sit under it in the same column. *@
    <div class="home-stack">
        <div class="readout-section">
            <div class="readout-header" @onclick="() => ShowVehicle = !ShowVehicle">
                VEHICLE <span>@(ShowVehicle ? "▼" : "▶")</span>
            </div>
            @if (ShowVehicle)
            {
                <VehicleSummary Data="@VehicleVM" />
            }
        </div>

        @if (!IsLoading && Notebook is not null)
        {
            <div class="readout-section">
                <div class="readout-header" @onclick="() => ShowNotebook = !ShowNotebook">
                    NOTES <span>@(ShowNotebook ? "▼" : "▶")</span>
                </div>

                @if (ShowNotebook)
                {
                    <NoteSummary NotebookData="@Notebook"
                                 Notes="@NotebookVMs"
                                 OnNotesChanged="ReloadNotebook" />
                }
            </div>
        }
    </div>

</div>

<div class="home-grid home-grid-base @PaneClass(HomeTab.Base)">

    <div class="readout-section">
        <div class="readout-header" @onclick="() => ShowBases = !ShowBases">
            BASES <span>@(ShowBases ? "▼" : "▶")</span>
        </div>
        @if (ShowBases)
        {
            <BaseSummary Data="@BaseVMs" />
        }
    </div>

    <div class="readout-section">
        <div class="readout-header" @onclick="() => ShowBaseContents = !ShowBaseContents">
            BASE CONTENTS <span>@(ShowBaseContents ? "▼" : "▶")</span>
        </div>
        @if (ShowBaseContents)
        {
            <BaseContents SelectedBase="@SelectedBase" />
        }
    </div>

</div>

<div class="home-grid home-grid-single @PaneClass(HomeTab.Extractors)">

    <div class="readout-section">
        <div class="readout-header" @onclick="() => ShowExtractors = !ShowExtractors">
            EXTRACTORS <span>@(ShowExtractors ? "▼" : "▶")</span>
        </div>
        @if (ShowExtractors)
        {
            <Extractors Data="@ExtractorVMs" />
        }
    </div>

</div>
